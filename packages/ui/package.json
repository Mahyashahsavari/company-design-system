{
  "name": "@monosuite/ui",
  "version": "0.0.0",
  "description": "MonosuiteProvider — wires @monosuite/theme into Mantine. Product UI comes from @mantine/core directly.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
